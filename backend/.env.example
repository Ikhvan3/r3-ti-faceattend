# Example only. Do not store real secrets here.
APP_ENV=local
APP_PORT=8080
BUSINESS_TIMEZONE=Asia/Jakarta
DB_HOST=localhost
DB_PORT=5432
DB_NAME=r3_ti_faceattend
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Authentication. Do not store real secrets here.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_HOURS=168
AUTH_TOKEN_ISSUER=r3-ti-faceattend-api
AUTH_TOKEN_AUDIENCE=r3-ti-faceattend-client
GEOFENCE_MAX_ACCURACY_METERS=50
# Required for standalone 1:1 face verification. Calibrate locally before use.
FACE_VERIFICATION_THRESHOLD=
# Required for 1:N duplicate-enrollment detection. Keep this separate from the
# verification threshold and calibrate it with representative samples.
FACE_DUPLICATE_ENROLLMENT_THRESHOLD=
FACE_DUPLICATE_SEARCH_TOP_K=20
# Short-lived server-issued attendance grant TTL. Development default is 120 seconds; calibrate for local device flow.
FACE_ATTENDANCE_GRANT_TTL_SECONDS=120

# Local admin seeder only. Do not store real credentials here.
ADMIN_EMPLOYEE_NUMBER=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_POSITION=

# Development attendance seeder only. Do not store real employee data here.
DEV_ATTENDANCE_USER_EMAIL=
DEV_ATTENDANCE_SCHEDULE_NAME=Jadwal Kerja Dummy TI
DEV_ATTENDANCE_START_TIME=08:00
DEV_ATTENDANCE_END_TIME=17:00
DEV_ATTENDANCE_GRACE_MINUTES=15
